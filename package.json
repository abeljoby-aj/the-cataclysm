{
  "name": "the-cataclysm-site",
  "version": "1.0.0",
  "private": true,
  "description": "THE CATACLYSM — OxCode inter-college CTF website",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve out",
    "typecheck": "tsc --noEmit",
    "preview:test": "http-server out -a 127.0.0.1 -p 4175 -c-1 --silent",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:built": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.0",
    "gsap": "^3.15.0",
    "next": "^16.4.2",
    "postprocessing": "^6.39.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "http-server": "^14.1.1",
    "typescript": "^5.9.3"
  }
}
